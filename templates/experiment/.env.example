# Configuration names for this experiment.
#
# Copy to .env and fill in values locally, or export the variables in your shell.
# Never commit a real .env file and never put a secret in this file.
# Every value here should be optional: the tool must work with none of them set.

# Where the tool stores its state (database, cache, logs).
# Default: ~/.local/share/<experiment-name>/
# EXAMPLE_DATA_DIR=$HOME/.local/share/example

# Maximum log level or verbosity.
# Default: info
# EXAMPLE_LOG_LEVEL=info

# A secret would look like this. Keep the placeholder empty and never fill it in here:
# EXAMPLE_API_TOKEN=
