# Configuration names for local-dashboard.
# Copy to .env and export the values, or export them in your shell.
# Every value is optional: the tool works with none of them set.
# Never commit a real .env file.

# Address to bind. Must be a loopback address; other addresses are refused.
# Default: 127.0.0.1
# DASHBOARD_HOST=127.0.0.1

# Port to listen on. Must be 1024 or higher; privileged ports are refused.
# Default: 8080
# DASHBOARD_PORT=8080

# Interpreter used by bin/local-dashboard.
# Default: python3
# PYTHON=python3
