# Configuration names for habit-tracker.
# Copy to .env and export the values, or export them in your shell.
# Every value is optional: the tool works with none of them set.
# Never commit a real .env file.

# Where the sqlite database lives.
# Default: $HOME/.local/share/habit-tracker/habits.db
# HABIT_DB=$HOME/.local/share/habit-tracker/habits.db

# Interpreter used by bin/habit.
# Default: python3
# PYTHON=python3
