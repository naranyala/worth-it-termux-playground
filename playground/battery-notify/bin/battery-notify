#!/usr/bin/env sh
# battery-notify - entry point for the battery notification experiment.
# The implementation lives in src/battery-notify.sh.
# POSIX sh; must pass `bash -n`.

set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$here/.." && pwd)

impl="$root/src/battery-notify.sh"

if [ ! -f "$impl" ]; then
    printf 'battery-notify: missing implementation: %s\n' "$impl" >&2
    exit 1
fi

exec sh "$impl" "$@"
