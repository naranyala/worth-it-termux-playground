# Configuration names for battery-notify.
# Copy to .env and export the values, or export them in your shell.
# Every value is optional: the tool works with none of them set.
# Never commit a real .env file.

# Battery percentage at or below which a notification is sent.
# Default: 20
# BATTERY_NOTIFY_THRESHOLD=20

# Where the "last notified" state is kept, so the script stays quiet when
# it is run repeatedly at the same low level.
# Default: $HOME/.local/state/battery-notify
# BATTERY_NOTIFY_STATE_DIR=$HOME/.local/state/battery-notify

# Shell used by the entry point.
# Default: sh
# SHELL_BIN=sh
