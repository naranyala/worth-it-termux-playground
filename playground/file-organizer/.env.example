# Configuration names for file-organizer.
# Copy to .env and export the values, or export them in your shell.
# Every value is optional: the tool works with none of them set.
# Never commit a real .env file.

# Directory to sort.
# Default: $HOME/storage/downloads
# FILE_ORGANIZER_TARGET=$HOME/storage/downloads

# Where the log of moves is kept, so a run can be reversed.
# Default: $HOME/.local/state/file-organizer/moves.log
# FILE_ORGANIZER_LOG=$HOME/.local/state/file-organizer/moves.log

# Interpreter used by bin/file-organizer.
# Default: python3
# PYTHON=python3
