# Configuration names for rss-digest.
# Copy to .env and export the values, or export them in your shell.
# Every value is optional: the tool works with none of them set.
# Never commit a real .env file.

# File with the feed list, one per line. Either a bare URL or "Name <url>".
# Default: $HOME/.config/rss-digest/feeds.txt
# RSS_FEEDS_FILE=$HOME/.config/rss-digest/feeds.txt

# Where the rendered digest is written.
# Default: $HOME/.local/share/rss-digest/digest.txt
# RSS_DIGEST_OUT=$HOME/.local/share/rss-digest/digest.txt

# Where downloaded feeds are cached, so a later run works without a network.
# Default: $HOME/.cache/rss-digest/feeds.json
# RSS_CACHE_FILE=$HOME/.cache/rss-digest/feeds.json

# Maximum entries per feed.
# Default: 10
# RSS_LIMIT=10

# Network timeout in seconds.
# Default: 20
# RSS_TIMEOUT=20

# Interpreter used by bin/rss-digest.
# Default: python3
# PYTHON=python3
